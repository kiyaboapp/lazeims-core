# LAZEIMS Central API — environment. Copy to .env and fill in.
# Config fails fast at startup if a required variable is missing (see app/config.py).

APP_NAME="LAZEIMS Central"
APP_ENV=development

# Session cookie signing secret (generate a strong random value in production).
SESSION_SECRET_KEY=dev-only-insecure-change-me

# PostgreSQL (async driver). Default local dev credentials: postgres/postgres.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/lazeims

# Zone-agnostic engine settings (no hardcoded geography here).
ZONE_NAME=

# Station package manifest signing/integrity key.
STATION_PACKAGE_INTEGRITY_KEY=dev-only-insecure-change-me

# Comma-separated allowed CORS origins for the browser frontend.
ALLOWED_CORS_ORIGINS=http://localhost:3000

# Cookie/session tuning
SESSION_COOKIE_NAME=lazeims_session
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false

# --- ExaMetrics (backend-sis) processing integration ---
# Base URL of the ExaMetrics integration API, e.g.
# https://api.exametrics.example/api/exametrics/v1
# Empty disables processing and results (collection-only deployment).
BACKEND_SIS_BASE_URL=

# Zone enrolment secret issued once by ExaMetrics. With it, Central asks
# ExaMetrics for each exam's API key server-to-server, so nobody ever copies a
# key. Empty means keys must be entered by hand under "Advanced (support only)".
BACKEND_SIS_PROVISION_SECRET=

# Outbound HTTP timeout for ExaMetrics calls, in seconds.
BACKEND_SIS_TIMEOUT_SECONDS=120

# ── Complete Station Bundle assembly ──────────────────────────────────────
# Where the station app + shared contract live (defaults assume sibling repos).
STATION_APP_DIR=../lazeims-station
LAZEIMS_COMMON_DIR=../lazeims-common
# Public base URL of this Central, embedded in bundles for sync-back.
# REQUIRED in production for online-first Station setup.
CENTRAL_PUBLIC_BASE_URL=
# Optional offline install / zero-install artifacts included in bundles.
STATION_WHEELHOUSE_DIR=
STATION_RUNTIME_DIR=

# ── Ed25519 package signing ───────────────────────────────────────────────
# Path to PEM-encoded Ed25519 private key for signing station packages.
# REQUIRED in production. Generate with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; k=Ed25519PrivateKey.generate(); open('package_signing.pem','wb').write(k.private_bytes(serialization.Encoding.PEM,serialization.PrivateFormat.PKCS8,serialization.NoEncryption()))"
# In dev/test, leave empty to use a deterministic test key (NOT for production).
PACKAGE_SIGNING_PRIVATE_KEY_PATH=
