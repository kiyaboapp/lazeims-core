# LAZEIMS Central API — environment. Copy to .env and fill in.
# Config fails fast at startup if a required variable is missing (see app/config.py).

APP_NAME="LAZEIMS Central"
APP_ENV=development

# Session cookie signing secret (generate a strong random value in production).
SESSION_SECRET_KEY=dev-only-insecure-change-me

# PostgreSQL (async driver). Default local dev credentials: postgres/postgres.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/lazeims

# Zone-agnostic engine settings (no hardcoded geography here).
ZONE_NAME=

# Station package manifest signing/integrity key.
STATION_PACKAGE_INTEGRITY_KEY=dev-only-insecure-change-me

# Comma-separated allowed CORS origins for the browser frontend.
ALLOWED_CORS_ORIGINS=http://localhost:3000

# Cookie/session tuning
SESSION_COOKIE_NAME=lazeims_session
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false

# --- Deferred / excluded in this delivery (do NOT implement a client) ---
# PROCESSING_API_BASE_URL=
# PROCESSING_API_KEY=
